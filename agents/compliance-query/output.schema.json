{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ComplianceQueryOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "status",
    "answer",
    "applicability",
    "citations",
    "control_gaps",
    "evidence_requirements",
    "recommendations",
    "uncertainty"
  ],
  "properties": {
    "protocol": {
      "const": "security-agent-suite.compliance-query.v1"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "insufficient_basis"
      ]
    },
    "answer": {
      "type": "string"
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applies",
        "assumptions",
        "reason"
      ],
      "properties": {
        "applies": {
          "enum": [
            "yes",
            "no",
            "conditional",
            "unknown"
          ]
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document",
          "issuer",
          "version",
          "effective_date",
          "location",
          "source_uri",
          "summary"
        ],
        "properties": {
          "document": {
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "effective_date": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "source_uri": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "validation_status": {
            "enum": [
              "validated",
              "needs_review"
            ]
          }
        }
      }
    },
    "control_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control",
          "status",
          "requirement_citation",
          "customer_evidence_refs",
          "reason"
        ],
        "properties": {
          "control": {
            "type": "string"
          },
          "status": {
            "enum": [
              "satisfied",
              "partially_satisfied",
              "not_satisfied",
              "not_assessed"
            ]
          },
          "requirement_citation": {
            "type": "string"
          },
          "customer_evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "evidence_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recommendation"
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "source_uri": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "excerpt": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "artifact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "collected_at": {
          "type": "string",
          "format": "date-time"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "priority"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "enum": [
            "immediate",
            "high",
            "medium",
            "low",
            "long_term"
          ]
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "severity",
        "confidence",
        "status",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "informational"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "asset_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attack_techniques": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        },
        "recommendations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recommendation"
          }
        }
      }
    },
    "limitation": {
      "type": "string",
      "minLength": 1
    }
  }
}

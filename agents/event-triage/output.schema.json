{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EventTriageOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "status",
    "summary",
    "classification",
    "severity",
    "confidence",
    "hypotheses",
    "evidence",
    "findings",
    "recommended_actions",
    "limitations"
  ],
  "properties": {
    "protocol": {
      "const": "security-agent-suite.event-triage.v1"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "insufficient_evidence"
      ]
    },
    "summary": {
      "type": "string"
    },
    "classification": {
      "enum": [
        "true_positive",
        "false_positive",
        "benign",
        "suspicious",
        "insufficient_evidence"
      ]
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "informational",
        "undetermined"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "attack_stage": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affected_assets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesis",
          "status",
          "supporting_evidence",
          "contradicting_evidence",
          "gaps"
        ],
        "properties": {
          "hypothesis": {
            "type": "string"
          },
          "status": {
            "enum": [
              "supported",
              "rejected",
              "possible",
              "unknown"
            ]
          },
          "supporting_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contradicting_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "gaps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "recommended_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recommendation"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/limitation"
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "source_uri": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "excerpt": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "collected_at": {
          "type": "string",
          "format": "date-time"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "priority"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "enum": [
            "immediate",
            "high",
            "medium",
            "low",
            "long_term"
          ]
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "severity",
        "confidence",
        "status",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "informational"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "asset_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attack_techniques": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        },
        "recommendations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recommendation"
          }
        }
      }
    },
    "limitation": {
      "type": "string",
      "minLength": 1
    }
  }
}

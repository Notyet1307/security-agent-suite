{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AttackPathValidationOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "status",
    "summary",
    "scope_check",
    "validations",
    "evidence",
    "findings",
    "attack_paths",
    "stop_reason",
    "limitations"
  ],
  "properties": {
    "protocol": {
      "const": "security-agent-suite.attack-path-validation.v1"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "blocked_by_policy",
        "insufficient_evidence"
      ]
    },
    "summary": {
      "type": "string"
    },
    "scope_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorized",
        "authorization_ref",
        "approval_id",
        "targets",
        "checks"
      ],
      "properties": {
        "authorized": {
          "type": "boolean"
        },
        "authorization_ref": {
          "type": "string"
        },
        "approval_id": {
          "type": "string"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "passed",
              "detail"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "passed": {
                "type": "boolean"
              },
              "detail": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "validations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "candidate",
          "method",
          "status",
          "evidence_refs",
          "side_effects_observed"
        ],
        "properties": {
          "target": {
            "type": "string"
          },
          "candidate": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "status": {
            "enum": [
              "verified",
              "likely_exploitable",
              "not_reproduced",
              "false_positive",
              "blocked_by_policy",
              "insufficient_evidence"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "side_effects_observed": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "attack_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "nodes",
          "edges",
          "cut_points"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "verified",
              "candidate",
              "rejected"
            ]
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "from",
                "to",
                "relation",
                "evidence_refs"
              ],
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "relation": {
                  "type": "string"
                },
                "evidence_refs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "cut_points": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "stop_reason": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/limitation"
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "source_uri": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "excerpt": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "artifact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "collected_at": {
          "type": "string",
          "format": "date-time"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "priority"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "enum": [
            "immediate",
            "high",
            "medium",
            "low",
            "long_term"
          ]
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "severity",
        "confidence",
        "status",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "informational"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "asset_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attack_techniques": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        },
        "recommendations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recommendation"
          }
        }
      }
    },
    "limitation": {
      "type": "string",
      "minLength": 1
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SecurityReportOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "status",
    "report_type",
    "period",
    "executive_summary",
    "metrics",
    "key_events",
    "recommendations",
    "artifacts",
    "validation",
    "limitations"
  ],
  "properties": {
    "protocol": {
      "const": "security-agent-suite.security-report.v1"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "insufficient_data"
      ]
    },
    "report_type": {
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "incident",
        "traffic",
        "compliance"
      ]
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "timezone"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string"
        }
      }
    },
    "executive_summary": {
      "type": "string"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "unit",
          "formula",
          "source_refs",
          "validated"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "integer",
              "string"
            ]
          },
          "unit": {
            "type": "string"
          },
          "formula": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "validated": {
            "type": "boolean"
          }
        }
      }
    },
    "trends": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "direction",
          "explanation",
          "source_refs"
        ],
        "properties": {
          "metric": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "up",
              "down",
              "flat",
              "not_comparable"
            ]
          },
          "explanation": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "key_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "severity",
          "summary",
          "source_refs"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recommendation"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "uri",
          "media_type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numbers",
        "citations",
        "template",
        "sensitive_data"
      ],
      "properties": {
        "numbers": {
          "enum": [
            "passed",
            "failed",
            "not_applicable"
          ]
        },
        "citations": {
          "enum": [
            "passed",
            "failed",
            "not_applicable"
          ]
        },
        "template": {
          "enum": [
            "passed",
            "failed",
            "not_applicable"
          ]
        },
        "sensitive_data": {
          "enum": [
            "passed",
            "failed",
            "not_applicable"
          ]
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/limitation"
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "source_uri": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "excerpt": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "artifact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "collected_at": {
          "type": "string",
          "format": "date-time"
          },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "priority"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "enum": [
            "immediate",
            "high",
            "medium",
            "low",
            "long_term"
          ]
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "severity",
        "confidence",
        "status",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "informational"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "asset_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attack_techniques": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        },
        "recommendations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recommendation"
          }
        }
      }
    },
    "limitation": {
      "type": "string",
      "minLength": 1
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/security-agent-suite/traffic-analysis-output.schema.json",
  "title": "TrafficAnalysisOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "status",
    "summary",
    "evidence",
    "timeline",
    "findings",
    "limitations"
  ],
  "properties": {
    "protocol": {
      "const": "security-agent-suite.traffic-analysis.v1"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "insufficient_evidence"
      ]
    },
    "summary": {
      "type": "string"
    },
    "input_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processable",
        "notes"
      ],
      "properties": {
        "processable": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "value"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "asset_ref": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "time",
          "event_type",
          "subject",
          "description",
          "evidence_refs",
          "confidence"
        ],
        "properties": {
          "time": {
            "type": "string",
            "format": "date-time"
          },
          "event_type": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "object": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "classification": {
            "enum": [
              "observed",
              "inferred",
              "reported"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "attack_path": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "relation",
          "verification",
          "evidence_refs"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "relation": {
            "type": "string"
          },
          "verification": {
            "enum": [
              "observed",
              "inferred",
              "unverified"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "affected_assets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/limitation"
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "source_uri": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "excerpt": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "collected_at": {
          "type": "string",
          "format": "date-time"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "priority"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "enum": [
            "immediate",
            "high",
            "medium",
            "low",
            "long_term"
          ]
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "title",
        "severity",
        "confidence",
        "status",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "informational"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "asset_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attack_techniques": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        },
        "recommendations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recommendation"
          }
        }
      }
    },
    "limitation": {
      "type": "string",
      "minLength": 1
    }
  }
}

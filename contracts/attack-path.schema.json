{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AttackPath",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "status",
    "nodes",
    "edges",
    "cut_points"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "verified",
        "candidate",
        "rejected"
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "relation",
          "verification",
          "evidence_refs"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "relation": {
            "type": "string"
          },
          "verification": {
            "enum": [
              "observed",
              "inferred",
              "unverified"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "cut_points": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

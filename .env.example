# security-agent-suite API
SAS_ADDR=:8080
SAS_API_KEY=change-me-in-production
SAS_EXECUTOR=mock
SAS_STATE_DIR=./var/state
SAS_ARTIFACT_DIR=./var/artifacts
SAS_WORKERS=3
SAS_QUEUE_SIZE=128
SAS_RUN_TIMEOUT=30m
SAS_SHUTDOWN_TIMEOUT=15s
SAS_MAX_BODY_BYTES=1048576
SAS_RATE_LIMIT_PER_MINUTE=120
SAS_LOG_LEVEL=info

# agent-compose CLI adapter (used when SAS_EXECUTOR=agentcompose-cli)
SAS_AGENT_COMPOSE_BIN=agent-compose
SAS_AGENT_COMPOSE_FILE=./agent-compose.yml
SAS_AGENT_COMPOSE_HOST=
SAS_AGENT_COMPOSE_PROJECT=security-agent-suite
SAS_AGENT_COMPOSE_TIMEOUT=35m
SAS_AGENT_COMPOSE_REMOVE_SANDBOX=true

# agent-compose project interpolation
# Guest image repository digest pinned by release-manifest.json.
# Runtime provider contract (must match the provider configured by the daemon).
LLM_API_ENDPOINT=
LLM_API_PROTOCOL=responses
LLM_API_KEY=
LLM_MODEL=

SAS_AGENT_MODEL=openai/gpt-5.4
SAS_REPORT_MODEL=openai/gpt-5.4
SAS_STRONG_AGENT_MODEL=openai/gpt-5.4
AGENT_COMPOSE_GUEST_IMAGE=docker.io/chaitin/agent-compose-guest@sha256:f1ebca0021d1de4ebd02d4da4117d7651e09b5a6db35be20092f03cc26a586b9

# OctoBus is configured on the agent-compose daemon. No default address or
# port is assumed; set the target environment endpoint explicitly.
SAS_OCTOBUS_HOST=
# M1-only live readiness probe. Set this to the 64-character lowercase hex ID
# of an operator-provisioned, isolated, retained sandbox in the fixed
# `sas101-doctor-probe` project, using the pinned guest image and only the
# pinned M1-only synthetic calculator fixture.
SAS_OCTOBUS_PROXY_SANDBOX_ID=
# The final endpoint and model must match the agent-compose daemon provider configuration;
# doctor verifies the configured model IDs through the provider /models endpoint.
# The capset IDs in agent-compose.yml are intentionally unqualified and resolve
# through that daemon-wide gateway.
